# LendingClub source data and derived datasets are rebuilt locally; do not commit them.
data/raw/
data/batches/
data/processed/

# Large binary intermediates. Keep small, auditable CSV/text outputs in outcomes/.
outcomes/*.parquet

# Python environments, bytecode, packaging, and test/tool caches.
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
build/
dist/

# Jupyter checkpoints only; project notebooks remain versioned.
.ipynb_checkpoints/

# Local secrets and machine-specific settings. Commit a .env.example if needed.
.env
.env.*
!.env.example

# dbt build artifacts.
dbt/target/
dbt/dbt_packages/
dbt/logs/
dbt/.user.yml

# Local command logs are not portable build evidence.
logs/

# Local databases and OS/editor clutter.
*.duckdb
.DS_Store
Thumbs.db
Desktop.ini
